{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraudwatch.local/contracts/fraud-label.v1.schema.json",
  "title": "FraudWatch fraud-label event v1",
  "description": "Canonical delayed fraud-label Kafka envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "fraud_label",
    "observed_at"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "fraud_label": {
      "type": "integer",
      "enum": [0, 1]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  },
  "x-fraudwatch-transport": {
    "encoding": "UTF-8 JSON",
    "maxBytes": 65536,
    "kafkaTopic": "fraud-labels.v1",
    "kafkaKeyField": "transaction_id",
    "timestampNormalization": "UTC"
  }
}
