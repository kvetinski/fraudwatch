{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraudwatch.local/contracts/transaction.v1.schema.json",
  "title": "FraudWatch transaction event v1",
  "description": "Canonical HTTP and Kafka transaction envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "customer_id",
    "terminal_id",
    "amount",
    "occurred_at"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "customer_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "terminal_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  },
  "x-fraudwatch-transport": {
    "encoding": "UTF-8 JSON",
    "maxBytes": 65536,
    "kafkaTopic": "transactions.v1",
    "kafkaKeyField": "terminal_id",
    "timestampNormalization": "UTC"
  }
}
