KAFKA_BROKERS=kafka:19092
KAFKA_TOPIC=transactions.v1
KAFKA_LABEL_TOPIC=fraud-labels.v1
FRAUDWATCH_METRICS_BIND=0.0.0.0
FRAUDWATCH_DB_PREPARE_THRESHOLD=1
FRAUDWATCH_NATIVE_MATH_THREADS=1
FRAUDWATCH_SCORING_BATCH_SIZE_PER_PARTITION=8
FRAUDWATCH_SCORING_BATCH_WAIT_SECONDS=0.025
FRAUDWATCH_LABEL_BATCH_SIZE_PER_PARTITION=64
FRAUDWATCH_LABEL_BATCH_WAIT_SECONDS=0.025
FRAUDWATCH_WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
FRAUDWATCH_MONITOR_INTERVAL_SECONDS=15
