# Copy to infra/k8s/fraudwatch.local.env and choose a local-only password.
# The copied file is ignored by Git.
POSTGRES_DB=fraudwatch
POSTGRES_USER=fraudwatch
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://fraudwatch:replace-with-a-local-password@postgres:5432/fraudwatch?sslmode=disable
DATABASE_URL_READ_ONLY=postgres://fraudwatch:replace-with-a-local-password@postgres:5432/fraudwatch?sslmode=disable&options=-cdefault_transaction_read_only%3Don
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
