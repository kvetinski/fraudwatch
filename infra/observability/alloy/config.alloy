discovery.docker "fraudwatch" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "fraudwatch" {
  targets = discovery.docker.fraudwatch.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "infra"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "fraudwatch" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.fraudwatch.output
  labels     = {"environment" = "local"}
  forward_to = [loki.process.fraudwatch.receiver]
}

loki.process "fraudwatch" {
  stage.docker {}
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
