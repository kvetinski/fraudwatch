{
  "uid": "fraudwatch-model-quality", "title": "FraudWatch — Model Quality", "tags": ["fraudwatch", "mlops"],
  "timezone": "browser", "schemaVersion": 41, "version": 1, "refresh": "1m", "time": {"from": "now-30d", "to": "now"},
  "panels": [
    {"id": 1, "title": "Monitoring evidence", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6}, "targets": [{"refId": "A", "expr": "fraudwatch_model_monitor_sample_count", "legendFormat": "samples"}, {"refId": "B", "expr": "fraudwatch_model_monitor_labeled_count", "legendFormat": "labeled"}, {"refId": "C", "expr": "fraudwatch_model_monitor_positive_count", "legendFormat": "positives"}, {"refId": "D", "expr": "fraudwatch_model_monitor_label_coverage_ratio", "legendFormat": "label coverage"}]},
    {"id": 2, "title": "Snapshot age", "type": "stat", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6}, "targets": [{"refId": "A", "expr": "fraudwatch_model_monitor_snapshot_age_seconds"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 3, "title": "Score and feature PSI", "type": "timeseries", "gridPos": {"x": 0, "y": 6, "w": 24, "h": 9}, "targets": [{"refId": "A", "expr": "fraudwatch_model_score_psi", "legendFormat": "score"}, {"refId": "B", "expr": "fraudwatch_model_feature_psi", "legendFormat": "{{feature}}"}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.2}, {"color": "red", "value": 0.3}]}}, "overrides": []}},
    {"id": 4, "title": "Delayed-label model quality", "type": "timeseries", "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "fraudwatch_model_quality", "legendFormat": "{{metric}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
    {"id": 5, "title": "Quality degradation from validation", "type": "timeseries", "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "fraudwatch_model_quality_degradation_ratio", "legendFormat": "{{metric}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.2}]}}, "overrides": []}},
    {"id": 6, "title": "Durable fraud-score distribution", "type": "timeseries", "gridPos": {"x": 0, "y": 23, "w": 24, "h": 8}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(fraudwatch_scoring_fraud_score_bucket[1h])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(fraudwatch_scoring_fraud_score_bucket[1h])))", "legendFormat": "p95"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(fraudwatch_scoring_fraud_score_bucket[1h])))", "legendFormat": "p99"}]}
  ]
}
