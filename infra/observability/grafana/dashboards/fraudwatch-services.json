{
  "uid": "fraudwatch-services", "title": "FraudWatch — Services", "tags": ["fraudwatch", "services"],
  "timezone": "browser", "schemaVersion": 41, "version": 1, "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Service scrape health", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 5}, "targets": [{"refId": "A", "expr": "up{job=~\"fraudwatch-.*\"}", "legendFormat": "{{job}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}},
    {"id": 2, "title": "Ingestion outcomes / second", "type": "timeseries", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(fraudwatch_ingestion_requests_total[5m]))", "legendFormat": "{{outcome}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 3, "title": "Ingestion p50 / p95 / p99", "type": "timeseries", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(fraudwatch_ingestion_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(fraudwatch_ingestion_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(fraudwatch_ingestion_request_duration_seconds_bucket[5m])))", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 4, "title": "Acknowledged worker outcomes / second", "type": "timeseries", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(fraudwatch_scoring_events_total[5m]))", "legendFormat": "scoring {{outcome}}"}, {"refId": "B", "expr": "sum by (outcome) (rate(fraudwatch_labels_events_total[5m]))", "legendFormat": "labels {{outcome}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 5, "title": "Worker acknowledgment latency p95", "type": "timeseries", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(fraudwatch_scoring_stage_seconds_bucket{stage=\"total\"}[5m])))", "legendFormat": "scoring"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(fraudwatch_labels_stage_seconds_bucket{stage=\"total\"}[5m])))", "legendFormat": "labels"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 6, "title": "PostgreSQL pool state", "type": "timeseries", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "fraudwatch_ingestion_db_pool_connections", "legendFormat": "{{state}}"}]},
    {"id": 7, "title": "Worker errors / minute", "type": "timeseries", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "60 * sum by (job, category) (rate({__name__=~\"fraudwatch_(scoring|labels)_errors_total\"}[5m]))", "legendFormat": "{{job}} {{category}}"}]}
  ]
}
